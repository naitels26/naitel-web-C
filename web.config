<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="NAITEL Node API Proxy" stopProcessing="true">
          <match url="^api/(chat|contact)$" />
          <action type="Rewrite"
                  url="http://127.0.0.1:8094/api/{R:1}"
                  appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension=".csv" />
      <mimeMap fileExtension=".csv" mimeType="text/csv; charset=utf-8" />
    </staticContent>
  </system.webServer>
  <!-- Pages and the partner list are revalidated on every visit so new uploads show up right away. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets/logos/partners.csv">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
